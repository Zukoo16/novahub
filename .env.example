# ==== NovaHub — переменные окружения ====
# Скопируйте в .env.local (git не отслеживает) и заполните нужное.

# Секрет для подписи сессий. Сгенерировать: npx tsx -e "import {generateSecret} from './src/lib/session'; console.log(generateSecret())"
# или просто длинная случайная строка.
SESSION_SECRET=

# Telegram Login Widget (необязательно — без него работает демо-вход)
# 1) Создайте бота у @BotFather, получите токен и username.
TG_BOT_USERNAME=
TG_BOT_TOKEN=

# Кому выдавать права администратора (email через запятую).
# В dev-режиме любой email с доменом @admin.local тоже получает права.
ADMIN_EMAILS=
